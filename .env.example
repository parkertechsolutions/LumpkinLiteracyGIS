# Local Postgres for development. Points at a Neon connection string in
# production — same schema, same wire protocol, no code changes required.
# Auth.js's database session strategy also lives here — a live connection is
# required to boot at all, not just for registrant data.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/rcm_dev

# Auth.js (auth.js.org). AUTH_SECRET: any random 32+ byte string, e.g.
# `openssl rand -base64 33`. Required to boot.
AUTH_SECRET=

# SMTP credentials for sending the magic-link sign-in email (FR-4). Any SMTP
# provider works — Resend, Postmark, SES, or a plain mailbox with an app
# password. Required for sign-in to actually deliver an email; the app boots
# without these, but no one can sign in.
EMAIL_SERVER_HOST=
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=
EMAIL_FROM=
